                    </div>

                    <div class="panel-body">
                        @{
                            var docsBD = (List<DocumentoVM>)ViewBag.Documentos ?? new List<DocumentoVM>();
                            var requeridos = (List<int>)ViewBag.DocumentosRequeridos;
                            var nombres = (Dictionary<int, string>)ViewBag.NombresDocumentos;
                        }

                        @if (!docsBD.Any())
                        {
                            <p>No hay documentos cargados.</p>
                        }

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Tipo Documento</th>
                                    <th>Fecha de carga</th>
                                    <th>Ver</th>
                                    @if (ViewBag.Modo == "editar")
                                    {
                                        <th>Actualizar documento</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var tipo in requeridos)
                                {
                                    var doc = docsBD.FirstOrDefault(d => d.IdTipoDocumento == tipo);

                                    <tr>
                                        <td>@nombres[tipo]</td>

                                        <td>
                                            @(doc != null ? doc.FechaCarga.ToString("dd/MM/yyyy") : "Sin documento")
                                        </td>

                                        <td>
                                            @if (doc != null)
                                            {
                                                <a href="@Url.Action("VerDocumento", "Documentos", new { id = doc.Id })"
                                                   target="_blank"
                                                   class="btn btn-primary btn-sm">
                                                    Ver PDF
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-danger">No disponible</span>
                                            }
                                        </td>

                                        @if (ViewBag.Modo == "editar")
                                        {
                                            <td>
                                                <input type="file"
                                                       name="archivos"
                                                       class="form-control"
                                                       accept=".pdf" />

                                                <input type="hidden"
                                                       name="tipos"
                                                       value="@tipo" />
                                            </td>
                                        }
                                    </tr>
                                }

                            </tbody>
                        </table>
