@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Validar Refrendo";

    var proveedor = ViewBag.Proveedor as Proveedores;
    var refrendo = ViewBag.Refrendo as Refrendos;
}
<div class="encabezado-login">
    <div class="encabezado-contenido">

        <div class="logo">
            <img src="~/Content/logo.jpeg" alt="Logo TRIJAEV" />
        </div>

        <div class="titulo">
            <h2>Sistema de Padrón de Proveedores V 2.0</h2>
            <p>Dirección de Administración</p>
            <p>Subdirección de Recursos Materiales</p>
        </div>

    </div>

</div>
<div class="container" style="margin-top:40px;">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h4 style="text-align:center">VALIDAR REFRENDO</h4>
        </div>

        <div class="panel-body">

            <div class="form-group">
                <label>No. Proveedor</label>
                <input class="form-control"
                       value="TRIJAEV-@proveedor.Id"
                       readonly />
            </div>

            <div class="form-group">
                <label>RFC</label>
                <input class="form-control"
                       value="@proveedor.RFC"
                       readonly />
            </div>

            <div class="form-group">
                <label>Razón Social</label>
                <input class="form-control"
                       value="@proveedor.Razon_Social"
                       readonly />
            </div>

            <div class="form-group">
                <label>Fecha Solicitud</label>
                <input class="form-control"
                       value="@refrendo.fechaSolicitud.ToString("dd/MM/yyyy HH:mm")"
                       readonly />
            </div>

            <br />

            <form method="post"
                  action="@Url.Action("ConfirmarValidacionRefrendo","Login")">

                <input type="hidden"
                       name="idRefrendo"
                       value="@refrendo.id" />

                <button type="submit"
                        class="btn btn-success">
                    Validar refrendo
                </button>

                <a href="@Url.Action("Lista","Login")"
                   class="btn btn-danger">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>
