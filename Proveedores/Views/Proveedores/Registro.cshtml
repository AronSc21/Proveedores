@{
    ViewBag.Title = "Registro de Proveedores";
}

<div ng-app="proveedoresApp"
     ng-controller="proveedoresController"
     class="container mt-4 mb-5">

    <h3 class="text-secondary mb-4">
        Solicitud de Registro al Padrón de Proveedores
    </h3>

    <form>


        <!-- ================= TIPO DE PERSONA ================= -->
        <div class="card mb-4">
            <div class="card-body">
                <label class="font-weight-bold d-block mb-2">Tipo de persona</label>

                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio"
                           id="personaFisica"
                           name="tipoPersona"
                           class="custom-control-input"
                           ng-model="proveedor.IdTipoPersona"
                           ng-value="1">
                    <label class="custom-control-label" for="personaFisica">
                        Persona Física
                    </label>
                </div>

                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio"
                           id="personaMoral"
                           name="tipoPersona"
                           class="custom-control-input"
                           ng-model="proveedor.IdTipoPersona"
                           ng-value="2">
                    <label class="custom-control-label" for="personaMoral">
                        Persona Moral
                    </label>
                </div>
            </div>
        </div>



        <!-- ================= DATOS GENERALES ================= -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light font-weight-bold">
                Datos Generales
            </div>
            <div class="card-body">

                <label>Razón Social *</label>
                <input class="form-control mb-2"
                       ng-model="proveedor.Razon_Social" required />

                <label>RFC *</label>
                <input class="form-control mb-2"
                       placeholder="Registro Federal de Contribuyentes" ng-model="proveedor.RFC"
                       maxlength="14" required />

                <label>CURP</label>
                <input class="form-control mb-2"
                        placeholder="Clave Única de Registro de Población" ng-model="proveedor.CURP" />

                <label>Giro Comercial</label>
                <input class="form-control"
                       ng-model="proveedor.Giro_Comercial" />

                <label>Estratificación</label>
                <input class="form-control"
                       placeholder="Micro,Pequeña o Mediana Empresa" ng-model="proveedor.Estratificacion" />
                
                <label>Fecha de solicitud</label>
                <input type="date" ng-model="proveedor.Fecha_Solicitud" ng-required="true" class="form-control" />

            </div>
        </div>

        <!-- ================= DOMICILIO ================= -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light font-weight-bold">
                Domicilio
            </div>
            <div class="card-body">
                <label>Calle *</label>
                <input class="form-control mb-2" ng-model="proveedor.Calle" />
                <label>Colonia *</label>
                <input class="form-control mb-2" ng-model="proveedor.Colonia" />

                <div class="row">
                    <div class="col-md-6">
                        <label>No.Exterior *</label>
                        <input class="form-control mb-2" ng-model="proveedor.No_Exterior" />
                    </div>
                    <div class="col-md-6">
                        <label>No. Interior *</label>
                        <input class="form-control mb-2" ng-model="proveedor.No_Interior" />
                    </div>
                </div>
                <label>Código postal *</label>
                <input class="form-control mb-2" ng-model="proveedor.Codigo_Postal" />
                <label>Localidad *</label>
                <input class="form-control mb-2" ng-model="proveedor.Localidad" />
                <label>Municipio *</label>
                <input class="form-control mb-2" ng-model="proveedor.Municipio" />
                <label>Estado *</label>
                <input class="form-control" ng-model="proveedor.Estado" />

            </div>
        </div>

        <!-- ================= CONTACTO ================= -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light font-weight-bold">
                Datos de Contacto
            </div>
            <div class="card-body">
                <label>Teléfono *</label>
                <input class="form-control mb-2" ng-model="proveedor.Telefono" />
                <label>Fax *</label>
                <input class="form-control mb-2" ng-model="proveedor.Fax" />
                <label>Página Web *</label>
                <input class="form-control" ng-model="proveedor.Pagina_Web" />

            </div>
        </div>

        <!-- ================= REPRESENTANTE ================= -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light font-weight-bold">
                Representante Legal
            </div>
            <div class="card-body">
                <label>Nombre *</label>
                <input class="form-control mb-2" ng-model="proveedor.Rep_Nombre" />
                <label>Teléfono *</label>
                <input class="form-control mb-2" ng-model="proveedor.Rep_Telefono" />
                <label>Extensión *</label>
                <input class="form-control mb-2" ng-model="proveedor.Rep_Extension" />
                <label>Correo electrónico *</label>
                <input class="form-control mb-2" ng-model="proveedor.Rep_Correo_E" />
                <label>Número de acta *</label>
                <input class="form-control mb-2" ng-model="proveedor.Rep_Numero_Acta" />
                <label>Número de poder *</label>
                <input class="form-control mb-2" ng-model="proveedor.Rep_Numero_Poder" />
                <label>Notario/Notaría *</label>
                <input class="form-control mb-2" ng-model="proveedor.Rep_Notario_Notaria" />
                <label>Personal designado para trámites ante la institución *</label>
                <input class="form-control" ng-model="proveedor.Rep_Personal_Tramite" />
                <label>Teléfono *</label>
                <input class="form-control" ng-model="proveedor.Tra_Telefono" />
                <label>Extensión *</label>
                <input class="form-control" ng-model="proveedor.Tra_Extension" />
                <label>Correo electrónico *</label>
                <input class="form-control" ng-model="proveedor.Tra_Correo_E" />

            </div>
        </div>

        <!-- ================= DATOS BANCARIOS ================= -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light font-weight-bold">
                Datos Bancarios
            </div>
            <div class="card-body">
                <label>Banco *</label>
                <input class="form-control mb-2" ng-model="proveedor.Ban_Banco" />
                <label>Cuenta *</label>
                <input class="form-control mb-2" ng-model="proveedor.Ban_Cuenta" />
                <label>Sucursal *</label>
                <input class="form-control mb-2" ng-model="proveedor.Ban_Sucursal" />
                <label>CLABE *</label>
                <input class="form-control" ng-model="proveedor.Ban_Clabe" />

            </div>
        </div>

        <!-- ================= DOCUMENTOS PERSONA FÍSICA ================= -->
        <div ng-show="proveedor.IdTipoPersona == 1" class="card mt-4">
            <div class="card-header bg-light">
                <strong>Documentos requeridos – Persona Física</strong>
            </div>

            <div class="card-body">
                <div class="form-group">
                    <label>Acta de Nacimiento *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],1)">
                </div>

                <div class="form-group">
                    <label>Identificación Oficial *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],2)">
                </div>

                <div class="form-group">
                    <label>Constancia de Situación Fiscal (SAT) *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],3)">
                </div>

                <div class="form-group">
                    <label>Última Declaración de Impuestos *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],4)">
                </div>

                <div class="form-group">
                    <label>Último Estado de Cuenta Bancario *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],5)">
                </div>
            </div>
        </div>



        <!-- ================= DOCUMENTOS PERSONA MORAL ================= -->
        <div ng-show="proveedor.IdTipoPersona == 2" class="card mt-4">
            <div class="card-header bg-light">
                <strong>Documentos requeridos – Persona Moral</strong>
            </div>

            <div class="card-body">
                <div class="form-group">
                    <label>Acta Constitutiva *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],6)">
                </div>

                <div class="form-group">
                    <label>Poder Notarial *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],7)">
                </div>

                <div class="form-group">
                    <label>Identificación Oficial del Representante Legal *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],8)">
                </div>

                <div class="form-group">
                    <label>Registro Federal de Contribuyentes (RFC) *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],9)">
                </div>

                <div class="form-group">
                    <label>Última Declaración de Impuestos *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],4)">
                </div>

                <div class="form-group">
                    <label>Último Estado de Cuenta Bancario *</label>
                    <input type="file" class="form-control-file"
                           onchange="angular.element(this).scope().agregarDocumento(this.files[0],5)">
                </div>
            </div>
        </div>



        <!-- ================= GUARDAR ================= -->
        <div class="text-center mt-5">
            <button type="button"
                    ng-click="guardarTodo()"
                    class="btn btn-success btn-lg px-5 shadow">
                Guardar Registro
            </button>

        </div>




